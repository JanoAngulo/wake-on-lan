#include <windows.h>

// Must match IDB_TILE in Credential.cpp.
#define IDB_TILE 101

IDB_TILE BITMAP "wake_tile.bmp"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1, 0, 0, 0
    PRODUCTVERSION 1, 0, 0, 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Wake Credential Provider"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "WakeCredentialProvider"
            VALUE "OriginalFilename", "WakeCredentialProvider.dll"
            VALUE "ProductName", "Wake"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
