#include <windows.h>

// Must match IDB_TILE in Credential.cpp.
#define IDB_TILE 101

// 128x128, 32-bit BI_RGB with premultiplied alpha (classic 40-byte header: LoadImageW rejects V5),
// a white fingerprint on transparent, like the built-in
// sign-in option icons. Same glyph as the app's WakeIcons.Fingerprint.
IDB_TILE BITMAP "wake_tile.bmp"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION 1, 0, 0, 0
    PRODUCTVERSION 1, 0, 0, 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Wake Credential Provider"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "WakeCredentialProvider"
            VALUE "OriginalFilename", "WakeCredentialProvider.dll"
            VALUE "ProductName", "Wake"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
